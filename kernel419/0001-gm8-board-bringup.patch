diff --git a/arch/arm64/boot/dts/gm/gm8-blsp1-qup1.dtsi b/arch/arm64/boot/dts/gm/gm8-blsp1-qup1.dtsi
new file mode 100644
index 000000000..eb73cc837
--- /dev/null
+++ b/arch/arm64/boot/dts/gm/gm8-blsp1-qup1.dtsi
@@ -0,0 +1,34 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* GM8 uses BLSP1 QUP1 for its TPS65132 panel-bias controller. */
+/ {
+	aliases {
+		i2c1 = &i2c_1;
+	};
+};
+
+&soc {
+	i2c_1: i2c@78b5000 {
+		compatible = "qcom,i2c-msm-v2";
+		#address-cells = <1>;
+		#size-cells = <0>;
+		reg-names = "qup_phys_addr";
+		reg = <0x78b5000 0x600>;
+		interrupt-names = "qup_irq";
+		interrupts = <0 95 IRQ_TYPE_LEVEL_HIGH>;
+		qcom,master-id = <86>;
+		qcom,clk-freq-out = <400000>;
+		qcom,clk-freq-in = <19200000>;
+		clock-names = "iface_clk", "core_clk";
+		clocks = <&gcc GCC_BLSP1_AHB_CLK>,
+			 <&gcc GCC_BLSP1_QUP1_I2C_APPS_CLK>;
+		dmas = <&dma_blsp1 8 64 0x20000020 0x20>,
+			<&dma_blsp1 9 32 0x20000020 0x20>;
+		dma-names = "tx", "rx";
+		pinctrl-names = "i2c_active", "i2c_sleep";
+		pinctrl-0 = <&i2c_1_active>;
+		pinctrl-1 = <&i2c_1_sleep>;
+		qcom,noise-rjct-scl = <0>;
+		qcom,noise-rjct-sda = <0>;
+		status = "okay";
+	};
+};
diff --git a/arch/arm64/boot/dts/gm/gm8-ramoops.dtsi b/arch/arm64/boot/dts/gm/gm8-ramoops.dtsi
new file mode 100644
index 000000000..a655242a6
--- /dev/null
+++ b/arch/arm64/boot/dts/gm/gm8-ramoops.dtsi
@@ -0,0 +1,15 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Reservation matches the verified GM8 3.18 diagnostic board tree. */
+/ {
+	reserved-memory {
+		gm8_ramoops: ramoops@9ff00000 {
+			compatible = "ramoops";
+			reg = <0x0 0x9ff00000 0x0 0x100000>;
+			record-size = <0x40000>;
+			console-size = <0x80000>;
+			pmsg-size = <0x40000>;
+			ecc-size = <16>;
+			no-map;
+		};
+	};
+};
