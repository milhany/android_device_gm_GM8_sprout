+	if (bq->skip_writes)
+		return 0;
+
+	mutex_lock(&bq->i2c_rw_lock);
+	ret = __fg_write_byte(bq->client, reg, val);
+	mutex_unlock(&bq->i2c_rw_lock);
+
+	return ret;
+}
