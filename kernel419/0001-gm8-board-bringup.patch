+static void determine_initial_status(struct bq2560x *bq)
+{
+	int ret;
+	u8 status = 0;
+	ret = bq2560x_get_hiz_mode(bq, &status);
+	if (!ret)
+		bq->in_hiz = !!status;
+
+	bq2560x_charger_interrupt(bq->client->irq, bq);
+}
