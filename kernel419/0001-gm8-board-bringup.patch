diff --git a/drivers/power/supply/gm8/bqfs_cmd_type.h b/drivers/power/supply/gm8/bqfs_cmd_type.h
new file mode 100644
index 000000000..311779ec6
--- /dev/null
+++ b/drivers/power/supply/gm8/bqfs_cmd_type.h
@@ -0,0 +1,42 @@
+
+
+#ifndef __BQFS_CMD_TYPE__
+#define __BQFS_CMD_TYPE__
+
+
+#define CMD_MAX_DATA_SIZE	110
+#define RETRY_LIMIT		3
+#define CMD_RETRY_DELAY		100 /* in ms */
+
+#ifdef __GNUC__
+#define __PACKED	__attribute__((packed))
+#else
+#error "Make sure structure cmd_t is packed"
+#endif
+
+typedef enum {
+	CMD_INVALID = 0,
+	CMD_R,	/* Read */
+	CMD_W,	/* Write */
+	CMD_C,	/* Compare */
+	CMD_X,	/* Delay */
+} cmd_type_t;
+
+/*
+ * DO NOT change the order of fields - particularly reg
+ * should be immediately followed by data
+ */
+typedef struct {
+	cmd_type_t cmd_type;
+	u8 addr;
+	u8 reg;
+	union {
+		u8 bytes[CMD_MAX_DATA_SIZE + 1];
+		u16 delay;
+	} data;
+	u8  data_len;
+	u16 line_num;
+} __PACKED bqfs_cmd_t;
+
+
+#endif
diff --git a/drivers/power/supply/gm8/gm8-power-compat.h b/drivers/power/supply/gm8/gm8-power-compat.h
new file mode 100644
index 000000000..75c42a1a9
--- /dev/null
+++ b/drivers/power/supply/gm8/gm8-power-compat.h
@@ -0,0 +1,40 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _GM8_POWER_COMPAT_H
+#define _GM8_POWER_COMPAT_H
+
+#include <linux/device.h>
+#include <linux/err.h>
+#include <linux/power_supply.h>
+
+static inline void gm8_put_power_supply(void *data)
+{
+	power_supply_put(data);
+}
+
+static inline struct power_supply *gm8_get_power_supply(struct device *dev,
+						       const char *name)
+{
+	struct power_supply *psy = power_supply_get_by_name(name);
+	int ret;
+
+	if (!psy)
+		return ERR_PTR(-EPROBE_DEFER);
+	ret = devm_add_action_or_reset(dev, gm8_put_power_supply, psy);
+	return ret ? ERR_PTR(ret) : psy;
+}
+
+static inline int gm8_psy_set_online(struct power_supply *psy, bool online)
+{
+	union power_supply_propval value = { .intval = online };
+
+	return power_supply_set_property(psy, POWER_SUPPLY_PROP_ONLINE, &value);
+}
+
+static inline int gm8_psy_set_present(struct power_supply *psy, bool present)
+{
+	union power_supply_propval value = { .intval = present };
+
+	return power_supply_set_property(psy, POWER_SUPPLY_PROP_PRESENT, &value);
+}
+
+#endif
