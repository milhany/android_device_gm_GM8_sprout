+static int bq2560x_wakeup_src_init(struct bq2560x *bq)
+{
+	spin_lock_init(&bq->bq2560x_ws.ws_lock);
+	bq->bq2560x_ws.source = wakeup_source_register(bq->dev, "bq2560x");
+	if (!bq->bq2560x_ws.source)
+		return -ENOMEM;
+	return devm_add_action_or_reset(bq->dev, bq2560x_unregister_wakeup,
+				       bq->bq2560x_ws.source);
+}
