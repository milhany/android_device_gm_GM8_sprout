index 000000000..95863f135
--- /dev/null
+++ b/drivers/power/supply/gm8/Kconfig
@@ -0,0 +1,17 @@
+config GM8_POWER
+	bool "General Mobile GM8 charger, fuel gauge and USB supply"
+	depends on MACH_GM_GM8 && I2C && POWER_SUPPLY && IIO
+	select EXTCON
+	select QCOM_SPMI_VADC
+	help
+	  Port of the GM8 BQ2560x charger and BQ27426 gauge, with the USB
+	  power-supply bridge expected by the MSM8937 USB PHY driver.
+
+config GM8_BQ27426_PROFILE_WRITE
+	bool "Allow GM8 fuel-gauge profile programming"
+	depends on GM8_POWER
+	default n
+	help
+	  Allows writes of the preserved GM8 calibration images to the gauge.
+	  Leave disabled during bring-up until battery-ID conversion, the
+	  selected physical battery and the existing gauge data are verified.
