+
+    ret = fts_i2c_read_reg(client, FTS_REG_LIC_VER, &lcd_ic_ver);
+	if (ret < 0) {
+		FTS_ERROR("get fw ver fail");
+		FTS_FUNC_EXIT();
+		return;
+	}
+
+	fw_ver = (tp_ic_fm_ver << 8) |lcd_ic_ver ;
+
+	snprintf(info, sizeof(info), "[fw]0x%x,[ic]FT8006M", fw_ver);
