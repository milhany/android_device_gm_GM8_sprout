+void lct_tp_info(struct i2c_client *client,char *module)
+{
+    char info[50] = {0};
+	u8 tp_ic_fm_ver,lcd_ic_ver;
+	int ret = 0,fw_ver;
+
+	FTS_FUNC_ENTER();
+    if(module && initialized)
+		return;
+
+    ret = fts_i2c_read_reg(client, FTS_REG_FW_VER, &tp_ic_fm_ver);
