+static ssize_t fg_attr_store_update(struct device *dev,
+				struct device_attribute *attr, const char *buf, size_t count)
+{
+
+	struct i2c_client *client = to_i2c_client(dev);
+	struct bq_fg_chip *bq = i2c_get_clientdata(client);
