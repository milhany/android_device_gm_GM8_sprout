@@ -0,0 +1,15 @@
+config GM8_TOUCH
+	bool "General Mobile GM8 touchscreen variants"
+	depends on MACH_GM_GM8 && I2C && INPUT_TOUCHSCREEN
+	help
+	  Preserved GM8 FT8006M and Himax input drivers. The stock panel-ID
+	  straps select the eligible driver before shared reset/IRQ pins are
+	  touched. Firmware programming and factory channels are disabled.
+
+config GM8_TOUCH_FOCALTECH
+	bool
+	default y if GM8_TOUCH
+
+config GM8_TOUCH_HIMAX
+	bool
+	default y if GM8_TOUCH
