+        tmp_data[3] = 0x00; tmp_data[2] = 0x00; tmp_data[1] = 0x00; tmp_data[0] = 0x3B;
+        himax_flash_write_burst(client, tmp_addr, tmp_data);
+
+        //==================================
+        // AHB_I2C Burst Read
+        // Set SPI data register : 0x8000_002C ==> 0x00
+        //==================================
+        out_buffer[0] = 0x2C;
