+/*****************************************************************************
+*
+* File Name: focaltech_point_report_check.c
+*
+*    Author: WangTao
+*
+*   Created: 2016-11-16
+*
+*  Abstract: point report check function
+*
+*   Version: v1.0
+*
+* Revision History:
+*        v1.0:
+*            First release. By WangTao 2016-11-16
+*****************************************************************************/
+
+/*****************************************************************************
+* Included header files
+*****************************************************************************/
+#include "focaltech_core.h"
+
+#if FTS_POINT_REPORT_CHECK_EN
+/*****************************************************************************
+* Private constant and macro definitions using #define
+*****************************************************************************/
+#define POINT_REPORT_CHECK_WAIT_TIME              200    /* unit:ms */
+
+/*****************************************************************************
+* functions body
+*****************************************************************************/
+/*****************************************************************************
+*  Name: fts_prc_func
+*  Brief: fts point report check work func, report whole up of points
+*  Input:
+*  Output:
+*  Return:
+*****************************************************************************/
+static void fts_prc_func(struct work_struct *work)
+{
+    struct fts_ts_data *ts_data = container_of(work,
+                                  struct fts_ts_data, prc_work.work);
+    struct input_dev *input_dev = ts_data->input_dev;
+
+#if FTS_MT_PROTOCOL_B_EN
+    unsigned int finger_count = 0;
+#endif
+
+    FTS_FUNC_ENTER();
+    mutex_lock(&ts_data->report_mutex);
+
+#if FTS_MT_PROTOCOL_B_EN
+    for (finger_count = 0; finger_count < ts_data->pdata->max_touch_number; finger_count++) {
+        input_mt_slot(input_dev, finger_count);
+        input_mt_report_slot_state(input_dev, MT_TOOL_FINGER, false);
+    }
+#else
+    input_mt_sync(input_dev);
+#endif
+    input_report_key(input_dev, BTN_TOUCH, 0);
+    input_sync(input_dev);
+
+    mutex_unlock(&ts_data->report_mutex);
+
+    FTS_FUNC_EXIT();
+}
+
+/*****************************************************************************
+*  Name: fts_prc_queue_work
+*  Brief: fts point report check queue work, call it when interrupt comes
+*  Input:
+*  Output:
+*  Return:
+*****************************************************************************/
+void fts_prc_queue_work(struct fts_ts_data *ts_data)
+{
+    cancel_delayed_work(&ts_data->prc_work);
+    queue_delayed_work(ts_data->ts_workqueue, &ts_data->prc_work,
+                       msecs_to_jiffies(POINT_REPORT_CHECK_WAIT_TIME));
+}
+
+/*****************************************************************************
+*  Name: fts_point_report_check_init
+*  Brief:
+*  Input:
+*  Output:
+*  Return: < 0: Fail to create esd check queue
+*****************************************************************************/
+int fts_point_report_check_init(struct fts_ts_data *ts_data)
+{
+    FTS_FUNC_ENTER();
+
+    if (ts_data->ts_workqueue) {
+        INIT_DELAYED_WORK(&ts_data->prc_work, fts_prc_func);
+    } else {
+        FTS_ERROR("fts workqueue is NULL, can't run point report check function");
+        return -EINVAL;
+    }
+
+    FTS_FUNC_EXIT();
+    return 0;
+}
+
+/*****************************************************************************
+*  Name: fts_point_report_check_exit
+*  Brief:
+*  Input:
+*  Output:
+*  Return:
+*****************************************************************************/
+int fts_point_report_check_exit(struct fts_ts_data *ts_data)
+{
+    FTS_FUNC_ENTER();
+    cancel_delayed_work_sync(&ts_data->prc_work);
+
+    FTS_FUNC_EXIT();
+    return 0;
+}
+#endif /* FTS_POINT_REPORT_CHECK_EN */
diff --git a/drivers/input/touchscreen/gm8/gm8-touch-board.c b/drivers/input/touchscreen/gm8/gm8-touch-board.c
new file mode 100644
index 000000000..1f034a6d5
--- /dev/null
+++ b/drivers/input/touchscreen/gm8/gm8-touch-board.c
@@ -0,0 +1,63 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#include <linux/err.h>
+#include <linux/gpio/consumer.h>
+#include <linux/mutex.h>
+#include <linux/pinctrl/consumer.h>
+#include "gm8-touch-board.h"
+
+static DEFINE_MUTEX(gm8_panel_id_lock);
+
+static enum gm8_touch_vendor gm8_touch_from_panel_ids(int id0, int id1)
+{
+	if (id0 == 1 && id1 == 1)
+		return GM8_TOUCH_FOCALTECH;
+	if ((id0 == 0 && id1 == 1) || (id0 == 1 && id1 == 0))
+		return GM8_TOUCH_HIMAX;
+	return GM8_TOUCH_UNKNOWN;
+}
+
+int gm8_touch_prepare(struct device *dev, enum gm8_touch_vendor expected)
+{
+	struct gpio_desc *id0, *id1;
+	struct pinctrl *pinctrl;
+	struct pinctrl_state *active;
+	int value0, value1, ret;
+
+	/* These are the original GM8 panel-ID straps (TLMM 59 and 27).
+	 * Serialize short reads and release both descriptors before returning,
+	 * so the ineligible driver never claims or resets the touch controller.
+	 */
+	mutex_lock(&gm8_panel_id_lock);
+	id0 = gpiod_get_index(dev, "panel-id", 0, GPIOD_IN);
+	if (IS_ERR(id0)) {
+		ret = PTR_ERR(id0);
+		goto unlock;
+	}
+	id1 = gpiod_get_index(dev, "panel-id", 1, GPIOD_IN);
+	if (IS_ERR(id1)) {
+		ret = PTR_ERR(id1);
+		gpiod_put(id0);
+		goto unlock;
+	}
+	value0 = gpiod_get_value_cansleep(id0);
+	value1 = gpiod_get_value_cansleep(id1);
+	gpiod_put(id1);
+	gpiod_put(id0);
+	dev_info(dev, "GM8 panel IDs %d/%d, requested %s\n", value0, value1,
+		 expected == GM8_TOUCH_FOCALTECH ? "FT8006M" : "Himax");
+	ret = value0 < 0 ? value0 : value1 < 0 ? value1 : 0;
+	if (!ret && gm8_touch_from_panel_ids(value0, value1) != expected)
+		ret = -ENODEV;
+unlock:
+	mutex_unlock(&gm8_panel_id_lock);
+	if (ret)
+		return ret;
+
+	pinctrl = devm_pinctrl_get(dev);
+	if (IS_ERR(pinctrl))
+		return PTR_ERR(pinctrl);
+	active = pinctrl_lookup_state(pinctrl, "pmx_ts_active");
+	if (IS_ERR(active))
+		return PTR_ERR(active);
+	return pinctrl_select_state(pinctrl, active);
+}
