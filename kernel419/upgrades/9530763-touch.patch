+*****************************************************************************/
+struct fts_mode_flag {
+    int  fts_glove_mode_flag;
+    int  fts_cover_mode_flag;
+    int  fts_charger_mode_flag;
+};
+
+struct fts_mode_flag g_fts_mode_flag;
+
+/*****************************************************************************
