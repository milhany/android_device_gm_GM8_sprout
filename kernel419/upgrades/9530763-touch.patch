+bool himax_check_chip_version(struct i2c_client *client)
+{
+	uint8_t tmp_addr[4];
+	uint8_t tmp_data[4];
+	uint8_t ret_data = false;
+	int i = 0;
+
+	for (i = 0; i < 5; i++)
+	{
+		// Product ID
+        // Touch
