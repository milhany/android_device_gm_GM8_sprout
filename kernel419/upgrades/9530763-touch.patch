+/*****************************************************************************
+*  Name: fts_reset_proc
+*  Brief: Execute reset operation
+*  Input: hdelayms - delay time unit:ms
+*  Output:
+*  Return:
+*****************************************************************************/
+int fts_reset_proc(int hdelayms)
+{
+    FTS_FUNC_ENTER();
+    gpio_direction_output(fts_data->pdata->reset_gpio, 0);
+    msleep(20);
+    gpio_direction_output(fts_data->pdata->reset_gpio, 1);
+    if (hdelayms) {
+        msleep(hdelayms);
+    }
+
+    FTS_FUNC_EXIT();
+    return 0;
