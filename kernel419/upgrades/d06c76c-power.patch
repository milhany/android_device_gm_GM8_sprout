+#define	CTRL_REG					0x00
+
+#define	FG_DFT_UNSEAL_KEY1				0x80008000
+#define	FG_DFT_UNSEAL_KEY2				0x36724614
+
+#define	FG_DFT_UNSEAL_FA_KEY			0xFFFFFFFF
+
+static u8 checksum(u8 *data, u8 len)
+{
+	u8 i;
+	u16 sum = 0;
+
+	for (i = 0; i < len; i++)
+		sum += data[i];
+
+	sum &= 0xFF;
+
+	return (0xFF - sum);
+}
