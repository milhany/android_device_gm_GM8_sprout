+static int show_registers(struct seq_file *m, void *data)
+{
+	struct bq2560x *bq = m->private;
+	u8 addr;
+	int ret;
+	u8 val;
+
+	for (addr = 0x0; addr <= 0x0B; addr++) {
+		ret = bq2560x_read_byte(bq, &val, addr);
+		if (!ret)
+			seq_printf(m, "Reg[%02X] = 0x%02X\n", addr, val);
+	}
+	return 0;
+}
