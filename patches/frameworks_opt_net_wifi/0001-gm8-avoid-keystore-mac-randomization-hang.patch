From: GM8 maintainers
Subject: [PATCH] wifi: allow per-network MAC randomization without legacy KeyStore

GM8 bugreport shows WifiHandlerThread blocked in HMAC key generation across
multiple ANRs. Opt in to the existing network MAC store and local random
address generator before making any KeyStore call. Preserve other products.
Also bypass KeyStore for the Soft AP hash caller, whose fallback is local
random MAC generation. This does not modify credentials or global Keymaster.

--- a/service/java/com/android/server/wifi/WifiConfigManager.java
+++ b/service/java/com/android/server/wifi/WifiConfigManager.java
@@ -42,6 +42,7 @@
 import android.net.wifi.WifiScanner;
 import android.os.Handler;
 import android.os.Process;
+import android.os.SystemProperties;
 import android.os.UserHandle;
 import android.os.UserManager;
 import android.provider.Settings;
@@ -488,6 +489,16 @@
                 mRandomizedMacAddressMapping.remove(config.getKey());
             }
         }
+        // Some legacy Keymaster HALs never complete HMAC key generation.
+        // Reuse the existing per-network store instead of blocking Wi-Fi on KeyStore.
+        if (SystemProperties.getBoolean("wifi.mac_rand_no_keystore", false)) {
+            MacAddress localMac = config.getRandomizedMacAddress();
+            if (!WifiConfiguration.isValidMacAddressForRandomization(localMac)) {
+                localMac = MacAddressUtils.createRandomUnicastAddress();
+            }
+            mRandomizedMacAddressMapping.put(config.getKey(), localMac.toString());
+            return localMac;
+        }
         MacAddress result = mMacAddressUtil.calculatePersistentMac(config.getKey(),
                 mMacAddressUtil.obtainMacRandHashFunction(Process.WIFI_UID));
         if (result == null) {
--- a/service/java/com/android/server/wifi/MacAddressUtil.java
+++ b/service/java/com/android/server/wifi/MacAddressUtil.java
@@ -17,6 +17,7 @@
 package com.android.server.wifi;
 
 import android.net.MacAddress;
+import android.os.SystemProperties;
 import android.security.keystore.AndroidKeyStoreProvider;
 import android.security.keystore.KeyGenParameterSpec;
 import android.security.keystore.KeyProperties;
@@ -86,6 +87,11 @@
     }
 
     private Mac obtainMacRandHashFunctionInternal(int uid, String alias) {
+        // Also protects Soft AP callers, which already handle a null hash function
+        // by generating a locally administered unicast address.
+        if (SystemProperties.getBoolean("wifi.mac_rand_no_keystore", false)) {
+            return null;
+        }
         try {
             KeyStore keyStore = AndroidKeyStoreProvider.getKeyStoreForUid(uid);
             // tries to retrieve the secret, and generate a new one if it's unavailable.
