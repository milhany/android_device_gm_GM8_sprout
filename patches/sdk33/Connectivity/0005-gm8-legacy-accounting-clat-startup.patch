diff --git a/service-t/jni/LegacyAccountingClient.h b/service-t/jni/LegacyAccountingClient.h
new file mode 100644
--- /dev/null
+++ b/service-t/jni/LegacyAccountingClient.h
@@ -0,0 +1,57 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include "FwmarkCommand.h"
+#include <cerrno>
+#include <cstring>
+#include <sys/socket.h>
+#include <sys/time.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+namespace android::gm8legacy {
+inline int request(FwmarkCommand::CmdId id, uid_t uid, uint32_t value, int passedFd = -1) {
+    static_assert(sizeof(FwmarkCommand) == 16);
+    static_assert(FwmarkCommand::_UNUSED_SET_COUNTERSET == 9);
+    static_assert(FwmarkCommand::_UNUSED_DELETE_TAGDATA == 10);
+    static_assert(FwmarkCommand::GM8_LEGACY_TAG_CLAT == 14);
+    FwmarkCommand command{};
+    command.cmdId = id;
+    command.uid = uid;
+    command.trafficCtrlInfo = value;
+    int fd = socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0);
+    if (fd < 0) return -errno;
+    auto finish = [fd](int error) { close(fd); return error; };
+    timeval timeout{5, 0};
+    if (setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &timeout, sizeof(timeout)) ||
+        setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &timeout, sizeof(timeout))) return finish(-errno);
+    sockaddr_un address{};
+    address.sun_family = AF_UNIX;
+    strcpy(address.sun_path, "/dev/socket/fwmarkd");
+    if (connect(fd, reinterpret_cast<sockaddr*>(&address), sizeof(address))) return finish(-errno);
+    iovec vector{&command, sizeof(command)};
+    msghdr message{};
+    message.msg_iov = &vector;
+    message.msg_iovlen = 1;
+    alignas(cmsghdr) char control[CMSG_SPACE(sizeof(int))]{};
+    if (passedFd >= 0) {
+        message.msg_control = control;
+        message.msg_controllen = sizeof(control);
+        cmsghdr* cmsg = CMSG_FIRSTHDR(&message);
+        cmsg->cmsg_level = SOL_SOCKET;
+        cmsg->cmsg_type = SCM_RIGHTS;
+        cmsg->cmsg_len = CMSG_LEN(sizeof(int));
+        memcpy(CMSG_DATA(cmsg), &passedFd, sizeof(passedFd));
+    }
+    ssize_t count;
+    do { count = sendmsg(fd, &message, MSG_NOSIGNAL); } while (count < 0 && errno == EINTR);
+    if (count < 0) return finish(-errno);
+    if (count != sizeof(command)) return finish(-EIO);
+    int result;
+    do { count = recv(fd, &result, sizeof(result), MSG_WAITALL); }
+    while (count < 0 && errno == EINTR);
+    if (count < 0) return finish(-errno);
+    if (count == 0) return finish(-ECONNRESET);
+    if (count != sizeof(result) || result > 0) return finish(-EPROTO);
+    return finish(result);
+}
+}  // namespace android::gm8legacy
