@@ -0,0 +1,62 @@
+/* Copyright 2026 The Android Open Source Project
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may obtain a copy at http://www.apache.org/licenses/LICENSE-2.0
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ */
+#pragma once
+
+#include <cstdint>
+#include <map>
+#include <mutex>
+#include <sys/types.h>
+#include <vector>
+
+namespace android {
+namespace net {
+
+// One instance owned by Controllers, shared by Binder permission updates and
+// fwmark socket requests. No state is duplicated in libnetd_updatable/APEXes.
+class LegacySocketTagger {
+  public:
+    static constexpr int INTERNET = 4;
+    static constexpr int UPDATE_DEVICE_STATS = 8;
+    static constexpr int UNINSTALLED = -1;
+
+    struct Paths {
+        const char* control = "/proc/net/xt_qtaguid/ctrl";
+        const char* device = "/dev/xt_qtaguid";
+        const char* passive = "/sys/module/xt_qtaguid/parameters/passive";
+        const char* trackingPassive = "/sys/module/xt_qtaguid/parameters/tag_tracking_passive";
+    };
+
+    LegacySocketTagger();
+    // Injectable paths for host fixtures. Production uses only the fixed paths.
+    explicit LegacySocketTagger(Paths paths);
+    ~LegacySocketTagger();
+    LegacySocketTagger(const LegacySocketTagger&) = delete;
+    LegacySocketTagger& operator=(const LegacySocketTagger&) = delete;
+
+    // PermissionMonitor supplies appIds, not per-user UIDs. Returns 0 or -errno.
+    int setPermissions(int permissions, const std::vector<int32_t>& appIds);
+    int tagSocket(int socketFd, uint32_t tag, uid_t chargeUid, uid_t realUid);
+    int untagSocket(int socketFd);
+
+  private:
+    int prepareLocked();
+    int writeCommandLocked(const char* command, size_t length);
+    bool mayChargeOthersLocked(uid_t realUid) const;
+    static int checkSocket(int socketFd);
+    static int requireActive(const char* path);
+
+    const Paths mPaths;
+    std::mutex mMutex;
+    // Keeping /dev/xt_qtaguid open gives the kernel a process owner for its
+    // socket tags; closing it on every command would release that ownership.
+    int mDeviceFd = -1;
+    std::map<uint32_t, uint8_t> mPermissions;
+};
+
+}  // namespace net
+}  // namespace android
