 }
 
+int LegacySocketTagger::checkReady() {
+    std::lock_guard guard(mMutex);
+    int result = prepareLocked();
+    if (result) return result;
+    for (const char* path : {mPaths.control, mPaths.stats, mPaths.ifaceFmt, mPaths.ifaceAll}) {
+        int fd;
+        do { fd = open(path, (path == mPaths.control ? O_WRONLY : O_RDONLY) | O_CLOEXEC); }
+        while (fd < 0 && errno == EINTR);
+        if (fd < 0) return -errno;
+        close(fd);
+    }
+    return 0;
+}
+
+int LegacySocketTagger::setCounterSet(uid_t uid, int set) {
+    if (uid > INT32_MAX || (set != 0 && set != 1)) return -EINVAL;
+    std::lock_guard guard(mMutex);
+    char command[64];
+    int length = snprintf(command, sizeof(command), "s %d %" PRIu32, set,
+                          static_cast<uint32_t>(uid));
+    if (length < 0 || static_cast<size_t>(length) >= sizeof(command)) return -EOVERFLOW;
+    return writeCommandLocked(command, length);
+}
+
+int LegacySocketTagger::deleteTagData(uid_t uid) {
+    if (uid > INT32_MAX) return -EINVAL;
+    std::lock_guard guard(mMutex);
+    char command[64];
+    int length = snprintf(command, sizeof(command), "d 0 %" PRIu32, static_cast<uint32_t>(uid));
+    if (length < 0 || static_cast<size_t>(length) >= sizeof(command)) return -EOVERFLOW;
+    return writeCommandLocked(command, length);
+}
+
+int LegacySocketTagger::checkClatSocket(int fd) {
+    int domain, protocol;
+    socklen_t size = sizeof(domain);
+    if (getsockopt(fd, SOL_SOCKET, SO_DOMAIN, &domain, &size)) return -errno;
+    if (domain != AF_INET6) return -EAFNOSUPPORT;
+    size = sizeof(protocol);
+    if (getsockopt(fd, SOL_SOCKET, SO_PROTOCOL, &protocol, &size)) return -errno;
+    return protocol == IPPROTO_RAW ? 0 : -EPROTONOSUPPORT;
+}
+
+int LegacySocketTagger::tagClatSocket(int fd) {
+    int result = checkClatSocket(fd);
+    if (result) return result;
+    std::lock_guard guard(mMutex);
+    char command[64];
+    int length = snprintf(command, sizeof(command), "t %d 0 %d", fd, AID_CLAT);
+    if (length < 0 || static_cast<size_t>(length) >= sizeof(command)) return -EOVERFLOW;
+    return writeCommandLocked(command, length);
+}
+
+int LegacySocketTagger::untagClatSocket(int fd) {
+    int result = checkClatSocket(fd);
+    if (result) return result;
+    std::lock_guard guard(mMutex);
+    char command[32];
+    int length = snprintf(command, sizeof(command), "u %d", fd);
+    if (length < 0 || static_cast<size_t>(length) >= sizeof(command)) return -EOVERFLOW;
+    return writeCommandLocked(command, length);
+}
+
 }  // namespace net
 }  // namespace android
