diff --git a/server/LegacyIngressRules.h b/server/LegacyIngressRules.h
new file mode 100644
--- /dev/null
+++ b/server/LegacyIngressRules.h
@@ -0,0 +1,102 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include <cerrno>
+#include <cstdint>
+#include <functional>
+#include <map>
+#include <net/if.h>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace android::net {
+// The owning FirewallController mutex serializes this with other UID rules.
+// Classic xt_bpf matches the real ingress ifindex; it uses no eBPF syscall/map.
+class LegacyIngressRules {
+  public:
+    inline static constexpr const char* CHAIN = "fw_gm8_iif";
+    using Writer = std::function<int(bool, const std::string&)>;
+    using Resolver = std::function<unsigned(const std::string&)>;
+    LegacyIngressRules(Writer writer, Resolver resolver)
+        : mWriter(std::move(writer)), mResolver(std::move(resolver)) {}
+    int initialize() {
+        mReady = false;
+        if (mWriter(false, rules({})) || mWriter(true, rules({}))) return -EREMOTEIO;
+        mState.clear();
+        mReady = true;
+        return 0;
+    }
+    int setLockdown(int32_t uid, int32_t rule) {
+        if (uid < 0 || (rule != 1 && rule != 2)) return -EINVAL;
+        auto next = mState;
+        next[uid].lockdown = (rule == 2);
+        return commit(std::move(next));
+    }
+    int addInterfaces(const std::string& iface, const std::vector<int32_t>& uids) {
+        if (iface.size() >= IFNAMSIZ) return -EINVAL;
+        const unsigned index = iface.empty() ? 0 : mResolver(iface);
+        if (!iface.empty() && index == 0) return -ENODEV;
+        auto next = mState;
+        for (int32_t uid : uids) {
+            if (uid < 0) return -EINVAL;
+            next[uid].hasInterface = true;
+            next[uid].index = index;
+        }
+        return commit(std::move(next));
+    }
+    int removeInterfaces(const std::vector<int32_t>& uids) {
+        auto next = mState;
+        for (int32_t uid : uids) {
+            if (uid < 0) return -EINVAL;
+            next[uid].hasInterface = false;
+            next[uid].index = 0;
+        }
+        return commit(std::move(next));
+    }
+    // SKF_AD_OFF + SKF_AD_IFINDEX is -4096 + 8, represented as uint32_t.
+    // Match all interfaces except the allowed index (index 0 is never a device).
+    static std::string wrongInterface(unsigned index) {
+        return "4,32 0 0 4294963208,21 0 1 " + std::to_string(index)
+                + ",6 0 0 0,6 0 0 4294967295";
+    }
+  private:
+    struct Entry { bool hasInterface = false; unsigned index = 0; bool lockdown = false; };
+    using State = std::map<int32_t, Entry>;
+    Writer mWriter;
+    Resolver mResolver;
+    bool mReady = false;
+    State mState;
+    static std::string rules(const State& state) {
+        const std::string prefix = std::string("-A ") + CHAIN;
+        std::string out = std::string("*filter\n:") + CHAIN + " -\n-F " + CHAIN + "\n";
+        out += prefix + " -i lo -j RETURN\n";
+        out += prefix + " -m owner --uid-owner 0-9999 -j RETURN\n";
+        out += prefix + " -p esp -j RETURN\n";
+        out += prefix + " -p tcp --tcp-flags RST RST -j RETURN\n";
+        // An always-false classic program probes support even with no UID rules.
+        out += prefix + " -m bpf --bytecode \"4,32 0 0 4294963208,21 0 1 0,6 0 0 0,6 0 0 0\" -j RETURN\n";
+        for (const auto& [uid, entry] : state) {
+            if (entry.hasInterface && entry.index != 0) {
+                out += prefix + " -m owner --uid-owner " + std::to_string(uid)
+                        + " -m bpf --bytecode \"" + wrongInterface(entry.index) + "\" -j DROP\n";
+            } else if (!entry.hasInterface && entry.lockdown) {
+                out += prefix + " -m owner --uid-owner " + std::to_string(uid) + " -j DROP\n";
+            }
+            // An explicit wildcard IIF rule overrides lockdown, matching SDK33.
+        }
+        return out + prefix + " -j RETURN\nCOMMIT\n";
+    }
+    int commit(State next) {
+        if (!mReady) return -ENODEV;
+        const std::string previous = rules(mState), candidate = rules(next);
+        if (mWriter(false, candidate) || mWriter(true, candidate)) {
+            // Try both rollbacks even if one fails. Do not publish a false cache.
+            int v4 = mWriter(false, previous), v6 = mWriter(true, previous);
+            if (v4 || v6) mReady = false;
+            return -EREMOTEIO;
+        }
+        mState = std::move(next);
+        return 0;
+    }
+};
+}  // namespace android::net
