diff --git a/server/LegacyBandwidthRules.h b/server/LegacyBandwidthRules.h
new file mode 100644
--- /dev/null
+++ b/server/LegacyBandwidthRules.h
@@ -0,0 +1,86 @@
+/* Copyright (C) 2026 GM8 contributors
