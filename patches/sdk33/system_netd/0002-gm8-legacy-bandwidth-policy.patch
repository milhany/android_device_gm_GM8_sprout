+#pragma once
+#include <cerrno>
+#include <climits>
+#include <cstdint>
+#include <functional>
+#include <set>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace android::net {
+// Called under BandwidthController::lock, after its base accounting hooks exist.
+class LegacyBandwidthRules {
+public:
+    using Writer = std::function<int(bool, const std::string&)>;
+    explicit LegacyBandwidthRules(Writer writer) : mWriter(std::move(writer)) {}
+    void invalidate() { mReady = false; }
+    int initialize() {
+        mReady = false; mNice.clear(); mNaughty.clear(); mSaver = false;
+        const std::string command = uidRules({}, {});
+        if (mWriter(false, command) != 0 || mWriter(true, command) != 0) return -EREMOTEIO;
+        mReady = true;
+        return 0;
+    }
+    int update(bool nice, bool add, const std::vector<uint32_t>& uids) {
+        for (uint32_t uid : uids) if (uid > INT32_MAX) return -EINVAL;
+        if (!mReady) return -ENODEV;
+        auto nextNice = mNice, nextNaughty = mNaughty;
+        auto& target = nice ? nextNice : nextNaughty;
+        for (uint32_t uid : uids) { if (add) target.insert(uid); else target.erase(uid); }
+        if (nextNice == mNice && nextNaughty == mNaughty) return 0;
+        const std::string next = uidRules(nextNice, nextNaughty), previous = uidRules(mNice, mNaughty);
+        const int result = writePair(next, next, previous, previous);
+        if (result == 0) { mNice = std::move(nextNice); mNaughty = std::move(nextNaughty); }
+        return result;
+    }
+    int dataSaver(bool enable) {
+        if (!mReady) return -ENODEV;
+        if (mSaver == enable) return 0;
+        const int result = writePair(saverRules(enable, false), saverRules(enable, true),
+                                     saverRules(mSaver, false), saverRules(mSaver, true));
+        if (result == 0) mSaver = enable;
+        return result;
+    }
+private:
+    Writer mWriter;
+    bool mReady = false, mSaver = false;
+    std::set<uint32_t> mNice, mNaughty;
+    static std::string uidRules(const std::set<uint32_t>& nice, const std::set<uint32_t>& naughty) {
+        std::string text = "*filter\n:bw_penalty_box -\n";
+        for (uint32_t uid : naughty) text += "-A bw_penalty_box -m owner --uid-owner " +
+                std::to_string(uid) + " -j REJECT\n";
+        text += "-A bw_penalty_box -j bw_happy_box\n:bw_happy_box -\n"
+                "-A bw_happy_box -m owner --uid-owner 0-9999 -j RETURN\n";
+        for (uint32_t uid : nice) text += "-A bw_happy_box -m owner --uid-owner " +
+                std::to_string(uid) + " -j RETURN\n";
+        return text + "-A bw_happy_box -j bw_data_saver\nCOMMIT\n";
+    }
+    static std::string saverRules(bool enable, bool ipv6) {
+        std::string text = "*filter\n:bw_data_saver -\n";
+        if (enable && ipv6) {
+            for (const char* type : {"packet-too-big", "router-solicitation", "router-advertisement",
+                                     "neighbour-solicitation", "neighbour-advertisement", "redirect"}) {
+                text += "-A bw_data_saver -p icmpv6 --icmpv6-type " + std::string(type) + " -j RETURN\n";
+            }
+        }
+        return text + "-A bw_data_saver -j " + (enable ? "REJECT" : "RETURN") + "\nCOMMIT\n";
+    }
+    int writePair(const std::string& next4, const std::string& next6,
+                  const std::string& previous4, const std::string& previous6) {
+        if (mWriter(false, next4) == 0 && mWriter(true, next6) == 0) return 0;
+        const int four = mWriter(false, previous4), six = mWriter(true, previous6);
+        if (four != 0 || six != 0) mReady = false;
+        return -EREMOTEIO;
+    }
+};
+}
