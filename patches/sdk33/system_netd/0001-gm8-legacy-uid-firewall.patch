+#pragma once
+
+#include <cerrno>
+#include <cstdint>
+#include <functional>
+#include <map>
+#include <set>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace android::net {
+
+// SDK33 standard UID chains on the GM8 qtaguid kernel. The owning
+// FirewallController mutex must be held. This is not a VPN-isolation backend.
+class LegacyUidFirewall {
+public:
+    using Writer = std::function<int(bool ipv6, const std::string&)>;
+    struct Chain { int32_t id; const char* name; bool allowlist; };
+    // IDs are the SDK33 ConnectivityManager FIREWALL_CHAIN_* values.
+    inline static constexpr Chain CHAINS[] = {
+            {1, "fw_dozable", true}, {2, "fw_standby", false},
+            {3, "fw_powersave", true}, {4, "fw_restricted", true},
+            {5, "fw_low_power_standby", true}, {7, "fw_oem_deny_1", false},
+            {8, "fw_oem_deny_2", false}, {9, "fw_oem_deny_3", false},
+    };
+    inline static constexpr const char* INPUT_ANCHOR = "fw_gm8_INPUT";
+    inline static constexpr const char* OUTPUT_ANCHOR = "fw_gm8_OUTPUT";
+
+    explicit LegacyUidFirewall(Writer writer) : mWriter(std::move(writer)) {}
+    bool ready() const { return mReady; }
+    void invalidate() { mReady = false; }
+
+    int initialize() {
+        mReady = false;
+        mRules.clear();
+        mEnabled.clear();
+        for (bool ipv6 : {false, true}) {
+            std::string command = "*filter\n";
+            for (const auto& chain : CHAINS) command += rulesBody(chain, {}, ipv6);
+            command += anchorsBody({}) + "COMMIT\n";
+            if (mWriter(ipv6, command) != 0) return -EREMOTEIO;
+        }
+        mReady = true;
+        return 0;
+    }
+
+    int setRule(int32_t id, int32_t uid, int32_t rule) {
+        const Chain* chain = findChain(id);
+        if (!chain) return unsupported(id);
+        if (uid < 0 || (rule != 1 && rule != 2)) return -EINVAL;
+        if (!mReady) return -ENODEV;
+        auto candidate = mRules[id];
+        if (chain->allowlist == (rule == 1)) candidate.insert(uid);
+        else candidate.erase(uid);
+        if (candidate == mRules[id]) return 0;
+        return replace(*chain, candidate);
+    }
+
+    int replaceChain(const std::string& name, bool allowlist, const std::vector<int32_t>& uids) {
+        const Chain* chain = nullptr;
+        for (const auto& item : CHAINS) if (name == item.name) chain = &item;
+        if (!chain || chain->allowlist != allowlist) return -EINVAL;
+        std::set<int32_t> candidate;
+        for (int32_t uid : uids) {
+            if (uid < 0) return -EINVAL;
+            candidate.insert(uid);
+        }
+        if (!mReady) return -ENODEV;
+        // Always rewrite on bulk replace, including an unchanged set.
+        return replace(*chain, candidate);
+    }
+
+    int enableChain(int32_t id, bool enable) {
+        if (!findChain(id)) return unsupported(id);
+        if (!mReady) return -ENODEV;
+        auto candidate = mEnabled;
+        if (enable) candidate.insert(id);
+        else candidate.erase(id);
+        if (candidate == mEnabled) return 0;
+        const std::string next = "*filter\n" + anchorsBody(candidate) + "COMMIT\n";
+        const std::string previous = "*filter\n" + anchorsBody(mEnabled) + "COMMIT\n";
+        const int result = writePair(next, next, previous, previous);
+        if (result == 0) mEnabled = std::move(candidate);
+        return result;
+    }
+
+private:
+    Writer mWriter;
+    bool mReady = false;
+    std::map<int32_t, std::set<int32_t>> mRules;
+    std::set<int32_t> mEnabled;
+
+    static const Chain* findChain(int32_t id) {
+        for (const auto& chain : CHAINS) if (chain.id == id) return &chain;
+        return nullptr;
+    }
+    static int unsupported(int32_t id) {
+        // NONE/global UID rules and LOCKDOWN_VPN require separate implementations.
+        return id == 0 || id == 6 ? -EOPNOTSUPP : -EINVAL;
+    }
+    static std::string anchorsBody(const std::set<int32_t>& enabled) {
+        std::string text;
+        for (const char* anchor : {INPUT_ANCHOR, OUTPUT_ANCHOR}) {
+            text += ":" + std::string(anchor) + " -\n";
+            for (int32_t id : enabled) {
+                const Chain* chain = findChain(id);
+                text += "-A " + std::string(anchor) + " -j " + chain->name + "\n";
+            }
+        }
+        return text;
+    }
+    static std::string rulesBody(const Chain& chain, const std::set<int32_t>& uids, bool ipv6) {
+        const std::string name = chain.name;
+        std::string text = ":" + name + " -\n";
+        // SDK33 bpf_owner_match bypasses system UIDs, ESP and TCP RSTs.
+        text += "-A " + name + " -m owner --uid-owner 0-9999 -j RETURN\n";
+        // Use an explicit UID match. A socket-only qtaguid rule also accounts
+        // traffic; repeating it in firewall chains would corrupt counters.
+        // The GM8 match interprets this range in init_user_ns.
+        text += "-A " + name + " -m owner ! --uid-owner 0-4294967294 -j RETURN\n";
+        text += "-A " + name + " -p esp -j RETURN\n";
+        text += "-A " + name + " -p tcp --tcp-flags RST RST -j RETURN\n";
+        if (ipv6 && chain.allowlist) {
+            for (const char* type : {"packet-too-big", "router-solicitation", "router-advertisement",
+                                     "neighbour-solicitation", "neighbour-advertisement", "redirect"}) {
+                text += "-A " + name + " -p icmpv6 --icmpv6-type " + type + " -j RETURN\n";
+            }
+        }
+        for (int32_t uid : uids) {
+            text += "-A " + name + " -m owner --uid-owner " + std::to_string(uid) +
+                    (chain.allowlist ? " -j RETURN\n" : " -j DROP\n");
+        }
+        if (chain.allowlist) text += "-A " + name + " -j DROP\n";
+        return text;
+    }
+    int replace(const Chain& chain, const std::set<int32_t>& candidate) {
+        const auto& previous = mRules[chain.id];
+        const int result = writePair("*filter\n" + rulesBody(chain, candidate, false) + "COMMIT\n",
+                                     "*filter\n" + rulesBody(chain, candidate, true) + "COMMIT\n",
+                                     "*filter\n" + rulesBody(chain, previous, false) + "COMMIT\n",
+                                     "*filter\n" + rulesBody(chain, previous, true) + "COMMIT\n");
+        if (result == 0) mRules[chain.id] = candidate;
+        return result;
+    }
+    int writePair(const std::string& next4, const std::string& next6,
+                  const std::string& previous4, const std::string& previous6) {
+        if (mWriter(false, next4) == 0 && mWriter(true, next6) == 0) return 0;
+        // iptables transactions are per-family, not cross-family. Attempt both
+        // rollbacks and keep the error visible. Unknown state requires re-init.
+        const int rollback4 = mWriter(false, previous4);
+        const int rollback6 = mWriter(true, previous6);
+        if (rollback4 != 0 || rollback6 != 0) mReady = false;
+        return -EREMOTEIO;
+    }
+};
+
+}  // namespace android::net
