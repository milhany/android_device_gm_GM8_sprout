+    if (android::base::GetBoolProperty("ro.vendor.gm8.legacy_cgroups", false)) {
+        if (!Load(CgroupMap::GetInstance(), TASK_PROFILE_DB_VENDOR_FILE)) {
+            LOG(ERROR) << "Loading complete legacy task profiles failed";
+        }
+        return;
