+// GM8: prefer a usable unified hierarchy, otherwise track processes on v1 cpuacct.
+// Check cgroup.procs as well as RC flags: SDK33 setup can mark an unmounted
+// unified root as mounted after its mount error was logged.
+static bool GetProcessGroupControllerPath(std::string* path,
+                                         bool* activate_controllers = nullptr) {
+    auto& map = CgroupMap::GetInstance();
+    auto unified = map.FindController(CGROUPV2_CONTROLLER_NAME);
+    if (unified.IsUsable() && unified.version() == 2 &&
+        access((std::string(unified.path()) + PROCESSGROUP_CGROUP_PROCS_FILE).c_str(), F_OK) == 0) {
+        *path = unified.path();
+        if (activate_controllers) *activate_controllers = true;
+        return true;
+    }
+    auto legacy = map.FindController("cpuacct");
+    if (legacy.IsUsable() && legacy.version() == 1 &&
+        access((std::string(legacy.path()) + PROCESSGROUP_CGROUP_PROCS_FILE).c_str(), F_OK) == 0) {
+        *path = legacy.path();
+        if (activate_controllers) *activate_controllers = false;
+        return true;
+    }
+    LOG(ERROR) << "No mounted process-group cgroup hierarchy";
+    errno = ENODEV;
+    return false;
 }
 
