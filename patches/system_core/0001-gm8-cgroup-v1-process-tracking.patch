+// GM8's 3.18 kernel has cgroup v1 only. Use a mounted accounting
+// hierarchy for uid/pid tracking; both versions expose cgroup.procs.
+static bool GetProcessGroupControllerPath(std::string* path) {
+    auto& map = CgroupMap::GetInstance();
+    auto unified = map.FindController(CGROUPV2_CONTROLLER_NAME);
+    if (unified.IsUsable()) {
+        *path = unified.path();
+        return true;
+    }
+    auto legacy = map.FindController("cpuacct");
+    if (legacy.IsUsable()) {
+        *path = legacy.path();
+        return true;
+    }
+    LOG(ERROR) << "No mounted process-group cgroup hierarchy";
+    errno = ENODEV;
+    return false;
+}
